# Copy this file to .env and fill in the values locally. Never commit .env.

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_ANON_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Google Sheets service account (set exactly one credential option)
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_SHEET_TAB=Grants

# Application URLs
# Comma-separated allowed frontend origins; set your Vercel URL on the backend.
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:8000

# Maximum age of a clearly labeled fallback sheet snapshot (seconds).
SHEET_CACHE_MAX_AGE_SECONDS=86400
